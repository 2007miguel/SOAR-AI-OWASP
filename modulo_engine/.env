# ── Knowledge Base ────────────────────────────────────────────────────────────
# Ruta al JSON dentro del volumen montado (NO cambiar: es la ruta dentro del contenedor)
KB_PATH=/app/kb/owasp_asi_knowledge_base.json

# ── Base de datos ─────────────────────────────────────────────────────────────
# host = "db" (nombre del servicio en docker-compose.yml), NO "localhost".
# El usuario/clave/BD de esta URL DEBEN coincidir con las 3 variables POSTGRES_* de abajo.
DB_URL=postgresql+psycopg2://postgres:soar_dev_pw@db:5432/soar_db

# Credenciales con las que docker-compose inicializa el contenedor db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=soar_dev_pw
POSTGRES_DB=soar_db

# ── Aplicación ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
