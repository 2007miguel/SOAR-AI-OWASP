          "activates_flags": ["api_access"],
          "operational_capability_ref": "OC-KC6.1",
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-TOOL-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-TOOL-03",
          "text": "¿El agente genera y ejecuta código o scripts de forma dinámica?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["code_execution"],
          "operational_capability_ref": "OC-KC6.2",
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-TOOL-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-TOOL-04",
          "text": "¿El agente ejecuta comandos del sistema operativo o interactúa con el OS directamente?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["os_commands"],
          "operational_capability_ref": "OC-KC6.5",
          "depends_on": {
            "operator": "OR",
            "conditions": [
              { "question_id": "Q-TOOL-01", "answer_value": true },
              { "question_id": "Q-TOOL-03", "answer_value": true }
            ]
          }
        },
        {
          "question_id": "Q-TOOL-05",
          "text": "¿El agente lee o escribe archivos en el sistema de archivos?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["filesystem_access"],
          "operational_capability_ref": "OC-KC6.5",
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-TOOL-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-TOOL-06",
          "text": "¿El agente consulta o modifica bases de datos (relacionales, NoSQL, vectoriales)?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["database_queries"],
          "operational_capability_ref": "OC-KC6.3",
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-TOOL-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-TOOL-07",
          "text": "¿El agente navega o interactúa con páginas web de forma autónoma?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["web_browsing"],
          "operational_capability_ref": "OC-KC6.4",
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-TOOL-01", "answer_value": true }]
          }
        }
      ]
    },
    {
      "section_id": "SEC-04",
      "title": "Integraciones avanzadas y dependencias externas",
      "description": "Evalúa el uso de protocolos de integración avanzados, plugins de terceros y acceso a infraestructura crítica. Corresponde a la parte restante de STEP-3 y al flag adicional de operational_capabilities.",
      "maps_to_kb_section": ["capability_taxonomy.STEP-3", "operational_capabilities.OC-KC6.6"],
      "questions": [
        {
          "question_id": "Q-INT-01",
          "text": "¿El agente utiliza servidores MCP (Model Context Protocol) para acceder a herramientas o recursos?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["mcp_server_integration"],
          "depends_on": null
        },
        {
          "question_id": "Q-INT-02",
          "text": "¿El agente se comunica con otros agentes utilizando protocolos A2A (Agent-to-Agent) u otros protocolos de colaboración inter-agente?",
