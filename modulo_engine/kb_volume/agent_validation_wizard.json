{
  "wizard_id": "AGENT_VALIDATION_WIZARD_V1",
  "version": "1.0",
  "description": "Wizard de registro estructurado para el sistema de validación y aseguramiento de agentes de IA. Produce exclusivamente el mapa de capability_flags activos que alimenta el pipeline de análisis del knowledge base. El contexto de negocio y metadata del agente se recogen en una capa de registro separada.",
  "knowledge_base_ref": "owasp_asi_knowledge_base.json",
  "output_schema": {
    "capability_flags": {
      "description": "Mapa de todos los flags posibles con valor boolean. true = activo, false = inactivo.",
      "flags": [
        "autonomous_planning", "goal_setting", "self_evaluation", "reflection_loops", "adaptive_reasoning",
        "short_term_memory", "long_term_memory", "rag_access", "shared_memory", "vector_database",
        "cross_session_context", "knowledge_base",
        "tool_use", "api_access", "code_execution", "os_commands", "filesystem_access",
        "database_queries", "web_browsing", "mcp_server_integration", "a2a_protocol",
        "third_party_plugins", "supply_chain_dependencies", "critical_systems_access",
        "user_authentication", "agent_identity", "delegated_credentials", "oauth_tokens",
        "api_keys", "inter_agent_trust", "persistent_agent_identity",
        "human_interaction", "human_in_the_loop", "user_facing_interface", "approval_workflows",
        "natural_language_communication", "persuasive_output", "explainability_features",
        "multi_agent_architecture", "agent_orchestration", "agent_delegation",
        "swarm_architecture", "central_orchestrator", "peer_to_peer_agents",
        "inter_agent_communication", "agent_to_agent_trust"
      ]
    }
  },
  "coverage_validation": {
    "description": "Tabla de cobertura. Mapea cada capability_flag al question_id que lo activa. Debe ejecutarse como validación automática cada vez que el wizard o el knowledge base se modifiquen. Si un flag no aparece aquí cubierto por al menos una pregunta, el pipeline quedará con un riesgo invisible.",
