          "required": true,
          "maps_to_step": "STEP-3",
          "activates_flags": ["tool_use"],
          "depends_on": null
        },
        {
          "question_id": "Q-TOOL-02",
          "text": "¿El agente realiza llamadas a APIs externas (REST, GraphQL, servicios de terceros)?",
