        {
          "question_id": "Q-INT-04",
          "text": "¿El agente depende de librerías externas, frameworks de terceros o proveedores de modelos externos?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["supply_chain_dependencies"],
          "depends_on": null
        },
        {
          "question_id": "Q-INT-05",
          "text": "¿El agente interactúa o tiene acceso a sistemas de infraestructura crítica (sistemas industriales SCADA, IoT, sistemas de control, redes eléctricas u otros sistemas de alta consecuencia)?",
          "type": "boolean",
          "required": false,
          "maps_to_step": null,
          "activates_flags": ["critical_systems_access"],
          "operational_capability_ref": "OC-KC6.6",
          "pipeline_note": "Este flag no activa ningún STEP de capability_taxonomy. El sistema debe procesarlo directamente contra operational_capabilities.OC-KC6.6 y aplicar el special_note de supervisión máxima.",
          "depends_on": null
        }
      ]
    },
    {
      "section_id": "SEC-05",
      "title": "Identidad y autenticación",
      "description": "Evalúa los mecanismos de autenticación usados por el agente y su propia identidad dentro del sistema. Corresponde a STEP-4 del Taxonomy Navigator.",
      "maps_to_kb_section": ["capability_taxonomy.STEP-4"],
      "questions": [
        {
          "question_id": "Q-AUTH-01",
          "text": "¿El agente verifica la identidad de los usuarios, herramientas o servicios con los que interactúa antes de ejecutar acciones?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-4",
          "activates_flags": ["user_authentication"],
          "depends_on": null
        },
        {
          "question_id": "Q-AUTH-02",
          "text": "¿El agente tiene una identidad propia asignada (ID de agente, service account, workload identity) que persiste entre sesiones o despliegues?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-4",
          "activates_flags": ["agent_identity", "persistent_agent_identity"],
          "depends_on": null
        },
        {
          "question_id": "Q-AUTH-03",
          "text": "¿Qué mecanismos de autenticación utiliza el agente para acceder a herramientas, APIs o servicios externos? (seleccionar todos los que apliquen)",
          "type": "multi_select",
          "required": false,
          "maps_to_step": "STEP-4",
          "options": [
            { "value": "oauth_tokens",        "label": "OAuth 2.0 / OIDC tokens", "activates_flags": ["oauth_tokens"] },
            { "value": "api_keys",            "label": "API keys estáticas o rotativas", "activates_flags": ["api_keys"] },
            { "value": "delegated_credentials","label": "Credenciales delegadas / heredadas del usuario", "activates_flags": ["delegated_credentials"] }
          ],
          "depends_on": {
            "operator": "OR",
            "conditions": [
              { "question_id": "Q-AUTH-01", "answer_value": true },
              { "question_id": "Q-AUTH-02", "answer_value": true }
            ]
          }
        },
        {
          "question_id": "Q-AUTH-04",
          "text": "¿El agente acepta o actúa sobre mensajes o instrucciones de otros agentes sin verificar su identidad de forma independiente?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-4",
          "activates_flags": ["inter_agent_trust"],
          "depends_on": null
        }
      ]
    },
    {
