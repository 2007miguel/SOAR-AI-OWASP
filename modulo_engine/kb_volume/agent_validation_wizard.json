    "known_gaps": [
      {
        "flag": "critical_systems_access",
        "note": "Este flag existe en operational_capabilities.OC-KC6.6.capability_flag_refs pero NO aparece en ningún STEP de capability_taxonomy. Está cubierto por Q-INT-05 en el wizard y activa controles de OC-KC6.6, pero no activará ningún STEP del pipeline de taxonomía. El sistema debe manejar este flag directamente contra operational_capabilities, no a través de capability_taxonomy."
      }
    ]
