          "required": false,
          "maps_to_step": "STEP-3",
          "activates_flags": ["a2a_protocol"],
          "depends_on": null
        },
        {
          "question_id": "Q-INT-03",
          "text": "¿El agente utiliza plugins, extensiones o herramientas de mercados o repositorios de terceros?",
          "type": "boolean",
