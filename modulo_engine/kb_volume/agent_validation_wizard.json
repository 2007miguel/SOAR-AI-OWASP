  "sections": [
    {
      "section_id": "SEC-01",
      "title": "Autonomía y razonamiento",
      "description": "Evalúa si el agente planifica, razona y se auto-evalúa de forma independiente. Corresponde a STEP-1 del Taxonomy Navigator.",
      "maps_to_kb_section": ["capability_taxonomy.STEP-1"],
      "questions": [
        {
          "question_id": "Q-AUT-01",
          "text": "¿El agente determina de forma independiente los pasos necesarios para alcanzar un objetivo, sin recibir instrucciones explícitas paso a paso?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-1",
          "activates_flags": ["autonomous_planning"],
          "depends_on": null
        },
        {
          "question_id": "Q-AUT-02",
          "text": "¿El agente puede definir o modificar sus propios objetivos de alto nivel durante la ejecución?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-1",
          "activates_flags": ["goal_setting"],
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-AUT-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-AUT-03",
          "text": "¿El agente evalúa sus propios outputs y realiza iteraciones o correcciones antes de entregar un resultado final?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-1",
          "activates_flags": ["self_evaluation", "reflection_loops"],
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-AUT-01", "answer_value": true }]
          }
        },
        {
          "question_id": "Q-AUT-04",
          "text": "¿El agente ajusta dinámicamente su estrategia de razonamiento basándose en resultados intermedios o nueva información recibida durante la tarea?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-1",
          "activates_flags": ["adaptive_reasoning"],
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-AUT-01", "answer_value": true }]
          }
        }
      ]
    },
    {
      "section_id": "SEC-02",
      "title": "Memoria y conocimiento",
      "description": "Evalúa el uso de memoria de corto y largo plazo, bases de conocimiento y contexto compartido. Corresponde a STEP-2 del Taxonomy Navigator.",
      "maps_to_kb_section": ["capability_taxonomy.STEP-2"],
      "questions": [
        {
          "question_id": "Q-MEM-01",
          "text": "¿El agente retiene información del contexto de la sesión actual para tomar decisiones durante esa misma sesión?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-2",
          "activates_flags": ["short_term_memory"],
          "depends_on": null
        },
        {
          "question_id": "Q-MEM-02",
          "text": "¿El agente retiene información entre sesiones distintas, es decir, recuerda interacciones o datos de sesiones anteriores?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-2",
          "activates_flags": ["long_term_memory", "cross_session_context"],
          "depends_on": null
        },
        {
          "question_id": "Q-MEM-03",
          "text": "¿El agente consulta una base de conocimiento externa, base de datos vectorial o sistema RAG para enriquecer sus respuestas?",
          "type": "boolean",
          "required": true,
          "maps_to_step": "STEP-2",
          "activates_flags": ["rag_access", "vector_database", "knowledge_base"],
          "depends_on": null
        },
        {
          "question_id": "Q-MEM-04",
          "text": "¿La memoria o el contexto del agente es compartida entre múltiples agentes o múltiples usuarios?",
          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-2",
          "activates_flags": ["shared_memory"],
          "depends_on": {
            "operator": "OR",
            "conditions": [
              { "question_id": "Q-MEM-02", "answer_value": true },
              { "question_id": "Q-MEM-03", "answer_value": true }
            ]
          }
        }
      ]
    },
    {
      "section_id": "SEC-03",
      "title": "Herramientas y ejecución",
      "description": "Evalúa el uso de herramientas externas, ejecución de código, acceso a sistemas de archivos y bases de datos. Corresponde a parte de STEP-3 del Taxonomy Navigator.",
      "maps_to_kb_section": ["capability_taxonomy.STEP-3", "operational_capabilities"],
      "questions": [
        {
          "question_id": "Q-TOOL-01",
          "text": "¿El agente utiliza herramientas externas, funciones o integraciones para realizar acciones más allá del texto (enviar emails, modificar archivos, llamar APIs, etc.)?",
