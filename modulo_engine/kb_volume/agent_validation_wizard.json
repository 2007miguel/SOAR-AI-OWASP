          "type": "boolean",
          "required": false,
          "maps_to_step": "STEP-5",
          "activates_flags": ["explainability_features"],
          "depends_on": {
            "operator": "OR",
            "conditions": [{ "question_id": "Q-HUM-01", "answer_value": true }]
          }
        }
      ]
    },
    {
