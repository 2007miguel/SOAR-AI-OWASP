# ── Knowledge Base ────────────────────────────────────────────────────────────
# Ruta absoluta al JSON principal dentro del volumen montado
KB_PATH=/app/kb/owasp_asi_knowledge_base.json

# ── Base de datos ─────────────────────────────────────────────────────────────
# El host es el nombre del servicio en docker-compose.yml (no "localhost")
DB_URL=postgresql+psycopg2://postgres:changeme@db:5432/soar_db

# Credenciales del servicio db en docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=soar_db

# ── Aplicación ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
