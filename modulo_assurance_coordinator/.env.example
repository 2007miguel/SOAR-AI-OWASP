# URL del engine — el coordinador llama de vuelta a este host cuando el caso está listo
ENGINE_URL=http://engine:8000

# Base de datos compartida con el engine (mismo PostgreSQL, tablas propias del coordinador)
DB_URL=postgresql+psycopg2://postgres:changeme@db:5432/soar_db

# App
LOG_LEVEL=INFO
PORT=8100
